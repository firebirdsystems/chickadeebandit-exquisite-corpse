    {
      "name": "starting a drawing takes a panel target and no artist list, and persists",
      "members": {
        "member": "adult"
      },
      "steps": [
        {
          "action": "open"
        },
        {
          "action": "click",
          "selector": "[data-testid=\"new-round\"]"
        },
        {
          "action": "waitFor",
          "selector": "[data-testid=\"round-form\"]"
        },
        {
          "action": "fill",
          "selector": "[data-testid=\"field-title\"]",
          "value": "Three Panel Beast"
        },
        {
          "action": "fill",
          "selector": "[data-testid=\"field-theme\"]",
          "value": "Something with too many legs"
        },
        {
          "action": "fill",
          "selector": "[data-testid=\"field-panel-target\"]",
          "value": "3"
        },
        {
          "action": "click",
          "selector": "[data-testid=\"round-submit\"]"
        },
        {
          "action": "waitFor",
          "selector": "[data-testid=\"draw-canvas\"]"
        },
        {
          "action": "expectText",
          "text": "0/3 panels drawn",
          "selector": "[data-testid=\"panel-progress\"]"
        },
        {
          "action": "reload"
        },
        {
          "action": "waitFor",
          "selector": "[data-testid=\"round-card\"]"
        },
        {
          "action": "expectCount",
          "selector": "[data-testid=\"round-card\"]",
          "count": 1
        },
        {
          "action": "expectText",
          "text": "Three Panel Beast",
          "selector": "[data-testid=\"round-list\"]"
        },
        {
          "action": "expectText",
          "text": "Add your panel",
          "selector": "[data-testid=\"round-status\"]"
        },
        {
          "action": "click",
          "selector": "[data-testid=\"round-card\"]"
        },
        {
          "action": "waitFor",
          "selector": "[data-testid=\"panel-progress\"]"
        },
        {
          "action": "expectText",
          "text": "0/3 panels drawn",
          "selector": "[data-testid=\"panel-progress\"]"
        },
        {
          "action": "expectText",
          "text": "Something with too many legs",
          "selector": "[data-testid=\"panel-progress\"]"
        }
      ]
    }
