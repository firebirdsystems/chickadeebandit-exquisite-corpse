    {
      "name": "starting a drawing needs only a title, and it persists",
      "members": {
        "host": "admin",
        "artist": "adult"
      },
      "steps": [
        {
          "action": "open",
          "as": "host"
        },
        {
          "action": "click",
          "selector": "[data-testid=\"new-round\"]",
          "as": "host"
        },
        {
          "action": "waitFor",
          "selector": "[data-testid=\"round-form\"]",
          "as": "host"
        },
        {
          "action": "fill",
          "selector": "[data-testid=\"field-title\"]",
          "value": "The Overambitious Beast",
          "as": "host"
        },
        {
          "action": "fill",
          "selector": "[data-testid=\"field-theme\"]",
          "value": "Something with too many legs",
          "as": "host"
        },
        {
          "action": "click",
          "selector": "[data-testid=\"round-submit\"]",
          "as": "host"
        },
        {
          "action": "waitFor",
          "selector": "[data-testid=\"draw-canvas\"]",
          "as": "host"
        },
        {
          "action": "expectText",
          "text": "0 panels drawn",
          "selector": "[data-testid=\"panel-progress\"]",
          "as": "host"
        },
        {
          "action": "reload",
          "as": "host"
        },
        {
          "action": "waitFor",
          "selector": "[data-testid=\"round-card\"]",
          "as": "host"
        },
        {
          "action": "expectCount",
          "selector": "[data-testid=\"round-card\"]",
          "count": 1,
          "as": "host"
        },
        {
          "action": "expectText",
          "text": "The Overambitious Beast",
          "selector": "[data-testid=\"round-list\"]",
          "as": "host"
        },
        {
          "action": "expectText",
          "text": "Add your panel",
          "selector": "[data-testid=\"round-status\"]",
          "as": "host"
        },
        {
          "action": "click",
          "selector": "[data-testid=\"round-card\"]",
          "as": "host"
        },
        {
          "action": "waitFor",
          "selector": "[data-testid=\"panel-progress\"]",
          "as": "host"
        },
        {
          "action": "expectText",
          "text": "0 panels drawn",
