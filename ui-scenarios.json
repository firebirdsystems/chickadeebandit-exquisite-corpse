{
  "scenarios": [
    {
      "name": "an artist can add a panel to a round someone else started, without waiting for a turn",
      "members": {
        "host": "admin",
        "artist": "adult"
      },
      "steps": [
        {
          "action": "seedRaw",
          "sql": "INSERT INTO app_exquisite_corpse__rounds (id, title, theme, visibility, status, panel_height, created_by_id, created_by_name, created_at, archived) VALUES (?, ?, ?, 'everyone', ?, 300, ?, ?, datetime('now'), 0)",
          "params": [
            "ui-r1",
            "The Beast of Maple Street",
            "A creature nobody has seen",
            "open",
            "{{host}}",
            "Host"
          ]
        },
        {
          "action": "seedRaw",
          "sql": "INSERT INTO app_exquisite_corpse__segments (id, round_id, member_id, member_name, position, file_id, file_url, created_at) VALUES (?, ?, ?, ?, ?, '', ?, datetime('now'))",
          "params": [
            "ui-s1",
            "ui-r1",
            "{{host}}",
            "Host",
            0,
            "data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mP8z8BQDwAEhQGAhKmMIQAAAABJRU5ErkJggg=="
          ]
        },
        {
          "action": "seedRaw",
          "sql": "INSERT INTO app_exquisite_corpse__handoffs (id, round_id, member_id, position, connectors, created_at) VALUES (?, ?, ?, ?, ?, datetime('now'))",
          "params": [
            "ui-h1",
            "ui-r1",
            "{{host}}",
            0,
            "[{\"x\": 0.35, \"color\": \"#7c3aed\"}]"
          ]
        },
        {
          "action": "open",
          "as": "artist"
        },
        {
          "action": "waitFor",
          "selector": "[data-testid=\"round-card\"][data-round-id=\"ui-r1\"]",
          "as": "artist"
        },
        {
          "action": "click",
          "selector": "[data-testid=\"round-card\"][data-round-id=\"ui-r1\"]",
          "as": "artist"
        },
        {
          "action": "waitFor",
          "selector": "[data-testid=\"draw-canvas\"]",
          "as": "artist"
        },
        {
          "action": "expectVisible",
          "selector": "[data-testid=\"submit-panel\"]",
          "as": "artist"
        },
        {
          "action": "expectNoText",
          "text": "Not your turn",
          "as": "artist"
        },
        {
          "action": "expectNoText",
          "text": "isn't taking panels",
          "as": "artist"
        },
        {
          "action": "expectText",
          "text": "1 panel drawn",
          "selector": "[data-testid=\"panel-progress\"]",
          "as": "artist"
        },
        {
          "action": "expectCount",
          "selector": "[data-testid=\"artist-row\"][data-drawn=\"1\"]",
          "count": 1,
          "as": "artist"
        },
        {
          "action": "expectCount",
          "selector": "[data-testid=\"artist-row\"][data-drawn=\"0\"]",
          "count": 1,
          "as": "artist"
        },
        {
          "action": "expectCount",
          "selector": "[data-testid=\"reveal-panel\"]",
          "count": 0,
          "as": "artist"
        },
        {
          "action": "expectCount",
          "selector": "[data-testid=\"panel-sealed\"]",
          "count": 0,
          "as": "artist"
        }
      ]
    },
